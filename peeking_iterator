//Time: O(1)
//space: O(1)
class PeekingIterator(object):
    def __init__(self, iterator):
        """
        :type iterator: Iterator
        """
        self.iterator = iterator
        self._next = self.iterator.next() if self.iterator.hasNext() else None

    def peek(self):
        """
        :rtype: int
        """
        return self._next

    def next(self):
        """
        :rtype: int
        """
        current = self._next
        self._next = self.iterator.next() if self.iterator.hasNext() else None
        return current

    def hasNext(self):
        """
        :rtype: bool
        """
        return self._next is not None
